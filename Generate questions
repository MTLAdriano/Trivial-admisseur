"""
generate_questions.py
Télécharge les questions depuis OpenQuizzDB (GitHub mirror Zeuh/OpenQuizzDB)
et génère le fichier questions.js pour EDHEC Trivial.

Usage:
    pip install requests
    python generate_questions.py
"""

import json, random, sys
try:
    import requests
except ImportError:
    print("❌ Module manquant. Lance : pip install requests")
    sys.exit(1)

BASE_URL = "https://raw.githubusercontent.com/Zeuh/OpenQuizzDB/master/data/openquizzdb_{}.json"

# Mapping catégories Trivial Pursuit -> IDs OpenQuizzDB
CATEGORIES = {
    "geo": [22, 66, 82, 104, 109, 121, 130, 133, 174, 30, 105, 112],
    "his": [70, 98, 120, 127, 160, 79, 111, 154, 155, 161, 165, 187, 190],
    "sci": [49, 65, 71, 97, 126, 135, 175, 184, 196, 123, 132],
    "art": [69, 86, 87, 128, 139, 140, 95, 159, 194],
    "spo": [23, 26, 72, 108, 138, 143, 144, 150, 153, 179, 185, 245],
    "ent": [36, 41, 46, 51, 52, 63, 81, 88, 90, 92, 163, 177],
}

CAT_LABELS = {
    "geo": "Géographie", "his": "Histoire", "sci": "Sciences & Nature",
    "art": "Arts & Littérature", "spo": "Sport & Loisirs", "ent": "Divertissement"
}

def fetch_quiz(qid):
    url = BASE_URL.format(qid)
    try:
        r = requests.get(url, timeout=10)
        if r.status_code == 200:
            return r.json()
    except Exception as e:
        print(f"  ⚠️  Quiz {qid} : {e}")
    return None

def extract_questions(data, cat_id, max_per_level=5):
    questions = []
    try:
        quizz = data.get('quizz', {})
        levels_data = None
        if 'débutant' in quizz:
            levels_data = quizz
        elif 'fr' in quizz and isinstance(quizz['fr'], list):
            levels_data = quizz['fr'][0]
        if not levels_data:
            return questions
        for level in ['débutant', 'confirmé', 'expert']:
            if level in levels_data:
                for q in levels_data[level][:max_per_level]:
                    props = q.get('propositions', [])
                    reponse = q.get('réponse', '')
                    if len(props) == 4 and reponse in props:
                        questions.append({
                            "q": q['question'],
                            "a": props,
                            "c": props.index(reponse),
                            "anecdote": q.get('anecdote', ''),
                            "cat": cat_id
                        })
    except Exception as e:
        print(f"  ⚠️  Extraction : {e}")
    return questions

def main():
    print("🎮 EDHEC Trivial — Génération de la banque de questions")
    print("=" * 55)

    all_questions = {cat: [] for cat in CATEGORIES}

    for cat_id, quiz_ids in CATEGORIES.items():
        print(f"\n📂 {CAT_LABELS[cat_id]}")
        for qid in quiz_ids:
            data = fetch_quiz(qid)
            if not data:
                print(f"  ✗ Quiz {qid} : non disponible")
                continue
            qs = extract_questions(data, cat_id)
            all_questions[cat_id].extend(qs)
            theme = data.get('thème', '?')[:40]
            print(f"  ✓ Quiz {qid:3d} ({theme}) → +{len(qs)} questions")

        # Shuffle pour varier l'ordre
        random.shuffle(all_questions[cat_id])
        print(f"  → Total {CAT_LABELS[cat_id]} : {len(all_questions[cat_id])} questions")

    # Stats finales
    print("\n" + "=" * 55)
    print("📊 Résumé :")
    total = 0
    for cat, qs in all_questions.items():
        print(f"  {CAT_LABELS[cat]:25s} : {len(qs):3d} questions")
        total += len(qs)
    print(f"  {'TOTAL':25s} : {total:3d} questions")

    # Écriture du fichier JS
    output = "const QUESTIONS_BANK = " + json.dumps(all_questions, ensure_ascii=False, separators=(',', ':')) + ";"
    with open("questions.js", "w", encoding="utf-8") as f:
        f.write(output)

    size_kb = len(output.encode('utf-8')) / 1024
    print(f"\n✅ questions.js généré ({size_kb:.0f} KB, {total} questions)")
    print("   Place-le dans le même dossier que index.html")

if __name__ == "__main__":
    main()
